# Database
DATABASE_URL=postgresql://restaurant:restaurant123@localhost:5432/restaurant_platform

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=development
# Comma-separated browser origins allowed for REST + (by default) Socket.IO CORS.
# Required in production whenever front-ends are not on localhost. Example:
# CORS_ORIGINS=https://pos.example.com,https://kitchen.example.com,https://orders.example.com
CORS_ORIGINS=
# Optional: override Socket.IO-only origins (otherwise uses CORS_ORIGINS, then localhost defaults)
# WS_CORS_ORIGINS=
# WebSocket: log every connect/subscribe (POS joins many rooms — noisy). Set to 1 only when debugging sockets.
# WS_VERBOSE=1

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=restaurant-assets

# Stripe (test mode — use keys from Stripe Dashboard » Developers » API keys, test mode toggle ON)
# Per-store overrides: Admin » Settings » General » Payment » Stripe (stored in DB; optional).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional redirects after Hosted Checkout (defaults target web-online local port)
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3002/orders?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3002/orders?checkout=cancel
STRIPE_PUBLISHABLE_KEY=

# PayPal REST (sandbox by default — optional fallback when Admin creds omitted)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# Square (optional fallback — store Admin settings preferred)
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_SANDBOX=true

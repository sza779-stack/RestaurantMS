// ============================================
// NEW: STAFF SUGGESTIONS
// ============================================

model StaffSuggestion {
  id         String  @id @default(uuid())
  storeId    String
  employeeId String?

  title       String
  description String
  category    SuggestionCategory @default(GENERAL)

  status SuggestionStatus @default(PENDING)

  priority SuggestionPriority @default(MEDIUM)

  adminResponse String?
  reviewedById  String?
  reviewedAt    DateTime?

  upvotes Int @default(0)

  createdAt DateTime @default(now())

  @@map("staff_suggestions")
}

// ============================================
// NEW: SCHEDULING & SHIFTS
// ============================================

model WorkSchedule {
  id      String @id @default(uuid())
  storeId String

  name      String
  weekStart DateTime
  weekEnd   DateTime

  status ScheduleStatus @default(DRAFT)

  shifts Shift[]

  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  publishedById String?

  @@map("work_schedules")
}

model Shift {
  id         String @id @default(uuid())
  scheduleId String
  employeeId String

  date      DateTime
  startTime DateTime
  endTime   DateTime

  position String?
  station  KitchenStation?

  status ShiftStatus @default(SCHEDULED)

  notes String?

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("shifts")
}

model ShiftTemplate {
  id      String @id @default(uuid())
  storeId String

  name      String
  dayOfWeek Int // 0-6 (Sunday-Saturday)

  startTime String // "HH:mm" format
  endTime   String // "HH:mm" format

  position String?
  station  KitchenStation?

  isActive Boolean @default(true)

  @@map("shift_templates")
}

// ============================================
// NEW: WAGE HISTORY
// ============================================

model WageHistory {
  id         String @id @default(uuid())
  employeeId String

  effectiveDate DateTime
  endDate       DateTime?

  hourlyRate Decimal? @db.Decimal(10, 2)
  salary     Decimal? @db.Decimal(10, 2)

  reason       String?
  approvedById String?

  createdAt DateTime @default(now())

  @@map("wage_histories")
}

// ============================================
// NEW: ATTENDANCE RECORDS
// ============================================

model AttendanceRecord {
  id         String @id @default(uuid())
  storeId    String
  employeeId String

  date   DateTime
  status AttendanceStatus

  clockIn  DateTime?
  clockOut DateTime?

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  breakDuration Int? // minutes

  overtimeHours Decimal? @db.Decimal(5, 2)

  notes        String?
  approvedById String?

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
  @@map("attendance_records")
}

// ============================================
// NEW: ANALYTICS SNAPSHOTS
// ============================================

model DailySalesSnapshot {
  id      String @id @default(uuid())
  storeId String

  date DateTime

  totalSales        Decimal @db.Decimal(12, 2)
  totalOrders       Int
  averageOrderValue Decimal @db.Decimal(10, 2)

  dineInSales   Decimal @db.Decimal(12, 2)
  pickupSales   Decimal @db.Decimal(12, 2)
  deliverySales Decimal @db.Decimal(12, 2)

  cashSales  Decimal @db.Decimal(12, 2)
  cardSales  Decimal @db.Decimal(12, 2)
  otherSales Decimal @db.Decimal(12, 2)

  taxAmount      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @db.Decimal(12, 2)
  refundAmount   Decimal @db.Decimal(12, 2)

  topProducts Json // Array of {productId, name, quantity, revenue}

  hourBreakdown Json // Sales by hour

  @@unique([storeId, date])
  @@map("daily_sales_snapshots")
}


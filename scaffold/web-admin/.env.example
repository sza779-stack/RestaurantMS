# Backend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Google Maps JS API key.
# Required for the Delivery Management / Driver Dispatch screens. Without it,
# those screens show a "Google Maps Load Error" panel instead of a map; the rest
# of the POS continues to work normally.
# Get a key from https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=
